# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
# .env는 절대 커밋하지 마세요 (.gitignore에 이미 포함되어 있습니다).
# 실행 시 실제 배포(GitHub Actions)에서는 이 값들을 Repository Secrets로 등록하세요.

# --- Telegram ---
TELEGRAM_AUCTION_BOT_TOKEN=
TELEGRAM_AUDIO_BOT_TOKEN=
TELEGRAM_AUCTION_CHANNEL_ID=
TELEGRAM_AUDIO_CHANNEL_ID=
TELEGRAM_ALLOWED_USER_ID=

# --- Vision providers ---
# Gemini Vision-first (recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Vision fallback (optional, default disabled)
OPENAI_API_KEY=
OPENAI_VISION_ENABLED=false

# --- Notion ---
NOTION_TOKEN=
NOTION_AUCTION_DB_URL=
# 레거시 호환: NOTION_AUCTION_DB_URL이 없을 때만 fallback으로 읽습니다.
# NOTION_HUSIK_DB_ID=

# --- Naver 블로그 검색 ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Feature flags (true/false) ---
COURT_AUCTION_ENABLED=true
MADANGS_ENABLED=true
BLOG_MONITOR_ENABLED=true
ENABLE_BLOG_AUGMENTATION=false
